PORT=54321
DATA_DIR=./data
REDIS_URL=redis://localhost:6379
WORKER_ENABLED=true
SYSTEM_STATUS_BASE_URL=
# Where the stack's services run; the start scripts set these. Sparkfire's models are fixed, so there are
# no model names or keys to choose. Leave the URLs empty to set up the stack in the browser.
SPARKFIRE_SETUP_COMPLETE=
SPARKFIRE_DEPLOYMENT_MODE=custom
LLM_BASE_URL=
OCR_BASE_URL=
STT_BASE_URL=
TRANSLATION_BASE_URL=
IMAGE_GENERATION_BASE_URL=
VIDEO_GENERATION_BASE_URL=
MUSIC_GENERATION_BASE_URL=
# The stack's SearXNG (compose.search.yaml); start-dgx-spark.sh sets it.
WEB_SEARCH_BASE_URL=
