# Copy to scripts/spark-switch.env and adjust for the LLM you keep running on the Spark.
LLM_CONTAINER=my-llm
LLM_HEALTH_URL=http://127.0.0.1:8888/v1/models
# vLLM exposes request counts here; servers without it skip the busy check.
LLM_METRICS_URL=http://127.0.0.1:8888/metrics
LLM_READY_TIMEOUT=1200
# Memory that must be free before the other stack starts.
MIN_FREE_GIB=100
