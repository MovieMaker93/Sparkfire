# Copy to scripts/spark-switch.env (git-ignored) and describe the other LLM you keep running on the Spark.
# The name of its Docker container (required).
LLM_CONTAINER=my-llm
# OpenAI-compatible endpoint used to confirm it is back up.
LLM_HEALTH_URL=http://127.0.0.1:8000/v1/models
# vLLM exposes request counts here; servers without it skip the busy check.
LLM_METRICS_URL=http://127.0.0.1:8000/metrics
LLM_READY_TIMEOUT=1200
# Memory that must be free before the other stack starts.
MIN_FREE_GIB=100
