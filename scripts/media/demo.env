# The demo copy of the app: its own port, data and Redis, the real model services, and the status proxy.
PORT=54400
DATA_DIR=/data
REDIS_URL=redis://127.0.0.1:6390
SPARKLINGKIT_SETUP_COMPLETE=true
SPARKLINGKIT_DEPLOYMENT_MODE=all-in-one
SYSTEM_STATUS_BASE_URL=http://127.0.0.1:8399
LLM_BASE_URL=http://127.0.0.1:8331/v1
LLM_MODEL=qwen36-35b-a3b-nvfp4
OCR_BASE_URL=http://127.0.0.1:8332/v1
OCR_MODEL=PaddleOCR-VL-1.6
STT_BASE_URL=http://127.0.0.1:8333/v1
STT_MODEL=Parakeet-TDT-0.6B-v3
TRANSLATION_BASE_URL=http://127.0.0.1:8334/v1
TRANSLATION_MODEL=Hy-MT2-1.8B-FP8
GROUNDING_BASE_URL=http://127.0.0.1:8335/v1
GROUNDING_MODEL=nvidia/LocateAnything-3B
IMAGE_GENERATION_BASE_URL=http://127.0.0.1:8336/v1
IMAGE_GENERATION_MODEL=Qwen-Image-2.1-Turbo
