# The demo copy of the app: its own port, data, Redis and SearXNG, the real model services, and the status proxy.
PORT=54400
DATA_DIR=/data
REDIS_URL=redis://127.0.0.1:6390
SPARKFIRE_SETUP_COMPLETE=true
SPARKFIRE_DEPLOYMENT_MODE=all-in-one
SYSTEM_STATUS_BASE_URL=http://127.0.0.1:8399
# Saluki 27B in llama-server, started by hand with --jinja (see docs/fork.md); populate-demo.sh declares its
# image input and tool calling in Settings.
LLM_BASE_URL=http://127.0.0.1:8331/v1
LLM_MODEL=saluki-27b
OCR_BASE_URL=http://127.0.0.1:8332/v1
OCR_MODEL=PaddleOCR-VL-1.6
STT_BASE_URL=http://127.0.0.1:8333/v1
STT_MODEL=Parakeet-TDT-0.6B-v3
TRANSLATION_BASE_URL=http://127.0.0.1:8334/v1
TRANSLATION_MODEL=Hy-MT2-1.8B-FP8
IMAGE_GENERATION_BASE_URL=http://127.0.0.1:8336/v1
IMAGE_GENERATION_MODEL=Qwen-Image-2.1-Turbo
VIDEO_GENERATION_BASE_URL=http://127.0.0.1:8337/v1
VIDEO_GENERATION_MODEL=FastH3
WEB_SEARCH_BASE_URL=http://127.0.0.1:8398
